generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(USER)
  isActive     Boolean    @default(true) @map("is_active")
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  documents    Document[]
  orders       Order[]
  couponRedemptions CouponRedemption[]
  notifications Notification[]
  wallet       Wallet?

  @@map("users")
}

model Document {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String    @map("file_name") @db.VarChar(255)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  fileSize     Int       @map("file_size")
  pageCount    Int?      @map("page_count")
  filePath     String    @map("file_path") @db.VarChar(500)
  status       DocStatus @default(UPLOADED)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orders       Order[]

  @@map("documents")
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique @map("order_number") @db.VarChar(50)
  userId        Int           @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId    Int           @map("document_id")
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  colorMode     String        @map("color_mode") @db.VarChar(20)
  paperSize     String        @map("paper_size") @db.VarChar(20)
  sides         String        @db.VarChar(20)
  orientation   String        @default("PORTRAIT") @db.VarChar(20)
  copies        Int           @default(1)
  pageRange     String        @default("all") @map("page_range") @db.VarChar(50)
  binding       String        @default("none") @db.VarChar(50)
  instructions  String?       @db.Text
  totalPages    Int           @default(1) @map("total_pages")
  subtotal      Float
  tax           Float
  totalAmount   Float         @map("total_amount")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod String        @default("SIMULATED_GATEWAY") @map("payment_method") @db.VarChar(50)
  orderStatus   OrderStatus   @default(RECEIVED) @map("order_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  couponId       Int?              @map("coupon_id")
  coupon         Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount Float             @default(0) @map("discount_amount")
  redemption     CouponRedemption?

  upiRefNumber        String?   @map("upi_ref_number") @db.VarChar(100)
  paymentRejectReason String?   @map("payment_reject_reason") @db.Text
  verifiedAt          DateTime? @map("verified_at")
  verifiedBy          Int?      @map("verified_by")

  qrToken     String?   @unique @map("qr_token") @db.VarChar(100)
  qrTokenUsed Boolean   @default(false) @map("qr_token_used")

  walletAmount Float     @default(0) @map("wallet_amount")

  feedbacks   Feedback[]

  @@map("orders")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum Role {
  USER
  PRINTER_ADMIN
  ADMIN
}

enum DocStatus {
  UPLOADED
  PROCESSING
  READY
  PRINTED
}

enum OrderStatus {
  RECEIVED
  PROCESSING
  PRINTED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  description   String?
  discountType  CouponType @map("discount_type")
  discountValue Float      @map("discount_value")
  minOrderValue Float?     @map("min_order_value")
  maxDiscount   Float?     @map("max_discount")
  usageLimit    Int?       @map("usage_limit")
  perUserLimit  Int?       @map("per_user_limit")
  usedCount     Int        @default(0) @map("used_count")
  expiresAt     DateTime?  @map("expires_at")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  orders        Order[]
  redemptions   CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  userId         Int      @map("user_id")
  orderId        Int      @unique @map("order_id")
  discountAmount Float    @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId],  references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

model OtpCode {
  id        Int        @id @default(autoincrement())
  email     String     @db.VarChar(255)
  code      String     @db.VarChar(10)
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime   @map("expires_at")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([email, purpose, isUsed])
  @@map("otp_codes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @default("INFO") @db.VarChar(50) // INFO, ORDER, APPROVAL, SECURITY
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model Feedback {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating            Int?
  message           String?  @db.Text
  featureSuggestion String?  @map("feature_suggestion") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

enum WalletTxType {
  CREDIT
  DEBIT
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float               @default(0)
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            Int          @id @default(autoincrement())
  txnNumber     String       @unique @map("txn_number") @db.VarChar(50)
  walletId      Int          @map("wallet_id")
  wallet        Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTxType
  amount        Float
  balanceBefore Float        @map("balance_before")
  balanceAfter  Float        @map("balance_after")
  description   String       @db.Text
  refType       String?      @map("ref_type") @db.VarChar(50) // "ORDER" | "TOPUP" | "REFUND"
  refId         Int?         @map("ref_id")
  referenceId   String?      @map("reference_id") @db.VarChar(100) // Custom searchable reference ID (Order # or Admin ref)
  createdBy     Int?         @map("created_by") // Admin User ID who initiated topup
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([walletId])
  @@index([txnNumber])
  @@index([referenceId])
  @@index([refType, refId])
  @@map("wallet_transactions")
}
