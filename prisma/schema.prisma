generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(USER)
  isActive     Boolean    @default(true) @map("is_active")
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  googleId     String?    @unique @map("google_id") @db.VarChar(100)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  documents    Document[]
  orders       Order[]
  couponRedemptions CouponRedemption[]
  notifications Notification[]
  wallet       Wallet?
  batchOrders  BatchOrder[]

  // Email notification preferences
  emailPrefOrders   Boolean @default(true) @map("email_pref_orders")
  emailPrefPayments Boolean @default(true) @map("email_pref_payments")
  emailPrefPromos   Boolean @default(true) @map("email_pref_promos")
  emailPrefDigest   Boolean @default(true) @map("email_pref_digest")
  unsubscribeToken  String? @unique @map("unsubscribe_token") @db.VarChar(64)

  @@map("users")
}

model Document {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String    @map("file_name") @db.VarChar(255)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  fileSize     Int       @map("file_size")
  pageCount    Int?      @map("page_count")
  filePath     String    @map("file_path") @db.VarChar(500)
  status       DocStatus @default(UPLOADED)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orders       Order[]

  @@map("documents")
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique @map("order_number") @db.VarChar(50)
  userId        Int           @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId    Int           @map("document_id")
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  colorMode     String        @map("color_mode") @db.VarChar(20)
  paperSize     String        @map("paper_size") @db.VarChar(20)
  sides         String        @db.VarChar(20)
  orientation   String        @default("PORTRAIT") @db.VarChar(20)
  copies        Int           @default(1)
  pageRange     String        @default("all") @map("page_range") @db.VarChar(50)
  binding       String        @default("none") @db.VarChar(50)
  instructions  String?       @db.Text
  totalPages    Int           @default(1) @map("total_pages")
  subtotal      Float
  tax           Float
  totalAmount   Float         @map("total_amount")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod String        @default("SIMULATED_GATEWAY") @map("payment_method") @db.VarChar(50)
  orderStatus   OrderStatus   @default(RECEIVED) @map("order_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  couponId       Int?              @map("coupon_id")
  coupon         Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount Float             @default(0) @map("discount_amount")
  redemption     CouponRedemption?

  upiRefNumber        String?   @map("upi_ref_number") @db.VarChar(100)
  paymentRejectReason String?   @map("payment_reject_reason") @db.Text
  verifiedAt          DateTime? @map("verified_at")
  verifiedBy          Int?      @map("verified_by")

  qrToken     String?   @unique @map("qr_token") @db.VarChar(100)
  qrTokenUsed Boolean   @default(false) @map("qr_token_used")

  walletAmount Float     @default(0) @map("wallet_amount")

  batchOrderId Int?          @map("batch_order_id")
  batchOrder   BatchOrder?   @relation(fields: [batchOrderId], references: [id], onDelete: SetNull)

  feedbacks   Feedback[]

  @@map("orders")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum Role {
  USER
  PRINTER_ADMIN
  ADMIN
}

enum DocStatus {
  UPLOADED
  PROCESSING
  READY
  PRINTED
}

enum OrderStatus {
  RECEIVED
  PROCESSING
  PRINTED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  description   String?
  discountType  CouponType @map("discount_type")
  discountValue Float      @map("discount_value")
  minOrderValue Float?     @map("min_order_value")
  maxDiscount   Float?     @map("max_discount")
  usageLimit    Int?       @map("usage_limit")
  perUserLimit  Int?       @map("per_user_limit")
  usedCount     Int        @default(0) @map("used_count")
  expiresAt     DateTime?  @map("expires_at")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  orders        Order[]
  redemptions   CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  userId         Int      @map("user_id")
  orderId        Int      @unique @map("order_id")
  discountAmount Float    @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId],  references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

model OtpCode {
  id        Int        @id @default(autoincrement())
  email     String     @db.VarChar(255)
  code      String     @db.VarChar(10)
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime   @map("expires_at")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([email, purpose, isUsed])
  @@map("otp_codes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @default("INFO") @db.VarChar(50) // INFO, ORDER, APPROVAL, SECURITY
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model Feedback {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating            Int?
  message           String?  @db.Text
  featureSuggestion String?  @map("feature_suggestion") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum AuditSeverity {
  INFO
  WARN
  ALERT
  CRITICAL
}

model AuditLog {
  id                 Int           @id @default(autoincrement())
  
  // Timing
  timestamp          DateTime      @default(now())
  latencyMs          Int?          @map("latency_ms")
  
  // Request Identity
  requestId          String        @map("request_id") @db.VarChar(36)
  method             String        @db.VarChar(10)
  route              String        @db.VarChar(500)
  fullUrl            String        @map("full_url") @db.VarChar(2000)
  statusCode         Int           @map("status_code")
  
  // User Context
  userId             Int?          @map("user_id")
  userEmail          String?       @map("user_email") @db.VarChar(255)
  userRole           String?       @map("user_role") @db.VarChar(20)
  
  // Network & IP
  ipAddress          String        @map("ip_address") @db.VarChar(45)
  ipForwarded        String?       @map("ip_forwarded") @db.VarChar(500)
  
  // Geo Location (from multi-provider cascade)
  geoCountry         String?       @map("geo_country") @db.VarChar(100)
  geoCountryCode     String?       @map("geo_country_code") @db.VarChar(10)
  geoRegion          String?       @map("geo_region") @db.VarChar(100)
  geoCity            String?       @map("geo_city") @db.VarChar(100)
  geoLat             Float?        @map("geo_lat")
  geoLon             Float?        @map("geo_lon")
  geoOrg             String?       @map("geo_org") @db.VarChar(200)
  geoAsn             String?       @map("geo_asn") @db.VarChar(100)
  geoTimezone        String?       @map("geo_timezone") @db.VarChar(100)
  geoProvider        String?       @map("geo_provider") @db.VarChar(50)
  geoIsProxy         Boolean?      @map("geo_is_proxy")
  geoIsTor           Boolean?      @map("geo_is_tor")
  geoIsHosting       Boolean?      @map("geo_is_hosting")
  
  // User Agent / Device Forensics
  userAgent          String?       @map("user_agent") @db.Text
  deviceType         String?       @map("device_type") @db.VarChar(30)
  deviceOs           String?       @map("device_os") @db.VarChar(50)
  deviceBrowser      String?       @map("device_browser") @db.VarChar(50)
  deviceBrowserVer   String?       @map("device_browser_ver") @db.VarChar(50)
  isBot              Boolean       @default(false) @map("is_bot")
  botName            String?       @map("bot_name") @db.VarChar(100)
  
  // Action Classification
  action             String        @db.VarChar(100)
  resourceType       String?       @map("resource_type") @db.VarChar(50)
  resourceId         String?       @map("resource_id") @db.VarChar(50)
  
  // Cyber Forensics & Threat Intel
  severity           AuditSeverity @default(INFO)
  threatFlags        String[]      @map("threat_flags")
  requestBodyHash    String?       @map("request_body_hash") @db.VarChar(64)
  referer            String?       @db.VarChar(2000)
  origin             String?       @db.VarChar(500)
  acceptLang         String?       @map("accept_lang") @db.VarChar(200)
  xRequestedWith     String?       @map("x_requested_with") @db.VarChar(100)
  contentType        String?       @map("content_type") @db.VarChar(200)
  
  // Session / Auth Context
  authMethod         String?       @map("auth_method") @db.VarChar(30)
  sessionFingerprint String?       @map("session_fingerprint") @db.VarChar(64)
  
  // Extra Forensics
  notes              String?       @db.Text
  
  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([ipAddress])
  @@index([statusCode])
  @@index([severity])
  @@index([action])
  @@index([requestId])
  @@index([isBot])
  @@map("audit_logs")
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float               @default(0)
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            Int          @id @default(autoincrement())
  txnNumber     String       @unique @map("txn_number") @db.VarChar(50)
  walletId      Int          @map("wallet_id")
  wallet        Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTxType
  amount        Float
  balanceBefore Float        @map("balance_before")
  balanceAfter  Float        @map("balance_after")
  description   String       @db.Text
  refType       String?      @map("ref_type") @db.VarChar(50) // "ORDER" | "TOPUP" | "REFUND"
  refId         Int?         @map("ref_id")
  referenceId   String?      @map("reference_id") @db.VarChar(100) // Custom searchable reference ID (Order # or Admin ref)
  createdBy     Int?         @map("created_by") // Admin User ID who initiated topup
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([walletId])
  @@index([txnNumber])
  @@index([referenceId])
  @@index([refType, refId])
  @@map("wallet_transactions")
}

model BatchOrder {
  id            Int           @id @default(autoincrement())
  batchNumber   String        @unique @map("batch_number") @db.VarChar(50)
  userId        Int           @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount   Float         @map("total_amount")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod String        @default("WALLET") @map("payment_method") @db.VarChar(50)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  orders        Order[]

  @@map("batch_orders")
}

model AdminBroadcast {
  id        Int      @id @default(autoincrement())
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  sentBy    Int      @map("sent_by")
  sentCount Int      @default(0) @map("sent_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_broadcasts")
}
