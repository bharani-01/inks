{
  "name": "printa",
  "version": "1.0.0",
  "description": "Document printing service — upload, configure, print, pay",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node utils/seedAdmin.js",
    "db:seed:printer": "node utils/seedPrinterAdmin.js",
    "db:studio": "npx prisma studio",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "adm-zip": "0.6.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "mammoth": "^1.12.1",
    "multer": "2.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "0.19.1",
    "qrcode": "^1.5.4",
    "resend": "6.18.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "3.1.9",
    "prisma": "6.9.0",
    "supertest": "^7.2.2"
  }
}
